{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@codeflow/types": ["../../packages/types/src/index.ts"],
      "@codeflow/visualization": ["./src/visualization/index.ts"],
      "@codeflow/language-adapters": ["../../packages/language-adapters/src/languageDetector.ts"],
      "@codeflow/execution-engine": ["../../packages/execution-engine/src/traceInterpreter.ts"],
      "@codeflow/semantic-engine": ["../../packages/semantic-engine/src/knowledgeGraph.ts"],
      "@codeflow/layout-engine": ["../../packages/layout-engine/src/treeLayout.ts"],
      "@codeflow/animation-engine": ["../../packages/animation-engine/src/springs.ts"],
      "@codeflow/plugin-registry": ["../../packages/plugin-registry/src/registry.ts"],
      "@codeflow/ai-engine": ["../../packages/ai-engine/src/stepExplainer.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
