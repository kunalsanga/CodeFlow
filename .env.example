# CodeFlow Global Environment Variables Example
# Copy to .env in respective workspace folders or configure in Vercel / Render dashboards.

# Frontend Environment Variables (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Environment Variables (services/backend)
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://codeflow-web.vercel.app
ENVIRONMENT=production
